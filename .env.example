# Copia este archivo como .env y completa los valores. NUNCA subas .env al repositorio.

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://<tu-proyecto>.supabase.co
# Clave secreta del servidor: "secret key" (sb_secret_...) o la legacy "service_role" (eyJ...)
SUPABASE_SECRET_KEY=
# Clave pública: "publishable key" (sb_publishable_...) o la legacy "anon" (eyJ...)
SUPABASE_PUBLISHABLE_KEY=

# --- Duffel (modo test: debe empezar por duffel_test_) ---
DUFFEL_ACCESS_TOKEN=

# --- Ingesta ---
INGESTION_SCHEDULE_ENABLED=true
INGESTION_CRON=0 * * * *
RUN_INGESTION_ON_START=false
TRACE_EVENTS=true
SCRAPER_POLITE_DELAY=0.6

# --- Modo caos de los proveedores simulados ---
CHAOS_ENABLED=true
CHAOS_FAILURE_RATE=0.25
CHAOS_MODES=503,429,timeout,malformed
CHAOS_POISON_ROUTES=BOG-LET
CHAOS_POISON_LOCATIONS=LET
